{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match your Worker's name in the Cloudflare dashboard.
  "name": "arcanum",
  "main": "worker.js",
  "compatibility_date": "2026-07-01",
  // Only ./public is served publicly (it contains just index.html), so the repo
  // source, git history, and docs can never be exposed as static assets.
  // GET requests are served from assets; POST falls through to worker.js.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Run worker.js BEFORE the asset layer so POST / (the advisor) and
    // POST /api/presence reach the Worker instead of being 405'd by assets.
    // The Worker serves GET requests via env.ASSETS.fetch itself.
    "run_worker_first": true
  },
  // Usage widget: one global Durable Object tracks live + total visitors.
  "durable_objects": {
    "bindings": [
      { "name": "STATS", "class_name": "Stats" },
      { "name": "RATELIMIT", "class_name": "RateLimiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Stats"] },
    { "tag": "v2", "new_sqlite_classes": ["RateLimiter"] }
  ]
}

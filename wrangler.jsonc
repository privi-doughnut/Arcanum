{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match your EXISTING Worker's name so it reuses the same URL + secret.
  "name": "arcanum-api-proxy",
  "main": "worker.js",
  "compatibility_date": "2026-07-01",
  // Only ./public is served publicly (it contains just index.html), so the repo
  // source, git history, and docs can never be exposed as static assets.
  // GET requests are served from assets; POST falls through to worker.js.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // Usage widget: one global Durable Object tracks live + total visitors.
  "durable_objects": {
    "bindings": [
      { "name": "STATS", "class_name": "Stats" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Stats"] }
  ]
}
